{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "buildCommand": "cd ./node/express-prisma-typescript/ && npm run build"
    },
    "deploy": {
      "runtime": "V2",
      "numReplicas": 1,
      "startCommand": "cd ./node/express-prisma-typescript/ && npm run prod",
      "sleepApplication": false,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }